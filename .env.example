# ---- 演练环境（docker compose） ----
COMPOSE_PROJECT_NAME=rollback-drill
API_HOST_PORT=18080
WEB_HOST_PORT=18081

DB_IMAGE=pgvector/pgvector:pg16
# 国内网络可换成镜像加速源（等价镜像）：
#   REDIS_IMAGE=docker.1panel.live/library/redis:7-alpine
REDIS_IMAGE=docker.1panel.live/library/redis:7-alpine
WEB_IMAGE=python:3.12-slim
POSTGRES_USER=drill
POSTGRES_PASSWORD=drill_only_fictional_pw
POSTGRES_DB=member_space

# ---- 被测服务镜像 ----
API_IMAGE=member-space-api
API_TAG=v1
GOOD_TAG=v1
BAD_TAG=v2

# ---- 应用配置 ----
APP_SECRET=drill-only-fictional-secret
REDIS_PREFIX=member-space:
WATCH_INTERVAL_S=2
WATCH_FAIL_THRESHOLD=2

# ---- 冒烟账号（虚构） ----
SMOKE_ORG_ID=00000000-0000-0000-0000-000000000001
SMOKE_USERNAME=drill_user
SMOKE_PASSWORD=Drill#2026
SMOKE_ACTIVITY_ID=11111111-1111-1111-1111-111111111111
SMOKE_KB_QUERY=资源对接流程

# ---- 回滚演练脚本 ----
API_BASE_URL=http://127.0.0.1:18080
WEB_BASE_URL=http://127.0.0.1:18081
ALERT_LOG=./run/alerts/alerts.log
ALERT_TIMEOUT_S=120
REDIS_CLI="docker compose -p rollback-drill exec -T redis redis-cli"
REDIS_PREFIX_CLEAN=member-space:
FRONTEND_CURRENT=./frontend/current
FRONTEND_RELEASE=./frontend/releases/v1
MAX_ROLLBACK_SECONDS=900
REPORT_DIR=./reports
