# 回滚演练环境变量示例（全部为虚构值，不含任何真实账号或密钥）
# 用法：cp .env.example .env，按需改端口即可。脚本只从环境变量读取，代码里没有硬编码。

# ---- 镜像与版本 ----
APP_IMAGE_REPO=member-space-drill/app
APP_CURRENT_TAG=1.0.0
APP_ROLLBACK_TAG=0.2.0
# 基础镜像 / 依赖镜像同样走环境变量：受限网络下可改成内部镜像源前缀
APP_BASE_IMAGE=python:3.11-slim
POSTGRES_IMAGE=postgres:16-alpine
NGINX_IMAGE=nginx:1.27-alpine

# ---- compose ----
COMPOSE_PROJECT_NAME=member-space-drill
COMPOSE_FILE=drill/docker-compose.yml
APP_NAME=member-space-api
APP_ENV_LABEL=drill-a
APP_PORT=8000
APP_BIND_HOST=0.0.0.0
API_UPSTREAM_HOST=api

# ---- 访问入口（演练脚本通过这些地址探活）----
DRILL_API_BASE_URL=http://127.0.0.1:18080
NGINX_HTTP_PORT=18080
NGINX_LISTEN_PORT=8080

# ---- 数据库（仅演练用的一次性凭据）----
POSTGRES_HOST=postgres
POSTGRES_PORT_INNER=5432
POSTGRES_USER=drill_user
POSTGRES_DB=member_space_drill
POSTGRES_PASSWORD=drillpass42
DB_CONNECT_TIMEOUT=2

# ---- 脚本行为 ----
HEALTH_CHECK_PATH=/health
VERSION_CHECK_PATH=/version
HEALTH_CHECK_TIMEOUT_SECONDS=60
HEALTH_CHECK_INTERVAL_SECONDS=2
ROLLBACK_SLA_SECONDS=900
# 失败注入：留空=不注入；可填 preflight|snapshot_before|switch_version|compose_up|health_check|verify_version|snapshot_after
DRILL_FAIL_STEP=
REPORT_DIR=reports
